# Copy to .env locally. Never paste or commit keys.
DEEPSEEK_API_KEY=
# Official model alias verified 2026-11-06; override to a model your account supports.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
TRIPWEAVE_PLANNER_EFFORT=max
TRIPWEAVE_RESEARCH_EFFORT=high
# Required for all real planning: Amap Web Service key (POI search and routes).
AMAP_API_KEY=
TRIPWEAVE_DATABASE=.runtime/tripweave.sqlite3
# Optional PostgreSQL connection. Leave empty to keep local SQLite.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/tripweave
DATABASE_URL=
TRIPWEAVE_MAX_REQUESTS=6
TRIPWEAVE_RUN_TIMEOUT=90
