# Copy to .env locally. Never paste or commit keys.
DEEPSEEK_API_KEY=
# Official model alias verified 2026-11-06; override to a model your account supports.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
TRIPWEAVE_PLANNER_EFFORT=max
TRIPWEAVE_RESEARCH_EFFORT=high
TRIPWEAVE_REVIEWER_EFFORT=max
# Required for all real planning: Amap Web Service key (POI search and routes).
AMAP_API_KEY=
TRIPWEAVE_DATABASE=.runtime/tripweave.sqlite3
# Optional PostgreSQL connection. Leave empty to keep local SQLite.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/tripweave
DATABASE_URL=
TRIPWEAVE_MAX_REQUESTS=null
TRIPWEAVE_RUN_TIMEOUT=600
TRIPWEAVE_PLANNER_MAX_TOKENS=null
TRIPWEAVE_RESEARCH_MAX_TOKENS=null
TRIPWEAVE_REVIEWER_MAX_TOKENS=null

# Completion-first experiment: null omits local caps; supplier limits still apply.
# Set numeric values later to restore measured experiment budgets.
TRIPWEAVE_MAX_CANDIDATES=null
