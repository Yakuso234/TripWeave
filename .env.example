# Copy to .env locally. Do not paste keys in chat or commit .env.
# Real-model modes need all three LLM values. Use your provider's compatible endpoint.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Real map mode also needs an Amap Web Service key.
AMAP_API_KEY=
TRIPWEAVE_DATABASE=.runtime/tripweave.sqlite3
TRIPWEAVE_MAX_REQUESTS=8
TRIPWEAVE_RUN_TIMEOUT=90
